{
  "name": "answerwall",
  "version": "0.1.0-rc.1",
  "private": true,
  "description": "One prompt in, many answers side by side.",
  "license": "MIT",
  "repository": "github:onlyfly34/answerwall",
  "type": "module",
  "packageManager": "pnpm@12.21.0",
  "engines": {
    "node": ">=24.15.0 <25"
  },
  "scripts": {
    "build": "pnpm -r run build",
    "dev": "pnpm -r --parallel run dev",
    "typecheck": "pnpm -r run typecheck",
    "lint": "eslint . --max-warnings 0 && node scripts/check-dependencies.mjs && node scripts/check-versions.mjs && prettier --check .",
    "test": "vitest run",
    "smoke:mock": "pnpm -r run build && node scripts/smoke-mock.mjs",
    "smoke:real": "pnpm -r run build && node scripts/smoke-real.mjs",
    "e2e": "pnpm --filter ./e2e test",
    "smoke:docker": "node docker/test/smoke.mjs",
    "format": "prettier --write ."
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "24.19.2",
    "eslint": "10.15.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-solid": "0.20.1",
    "globals": "17.14.0",
    "prettier": "3.10.1",
    "typescript": "6.0.3",
    "typescript-eslint": "8.73.0",
    "vitest": "5.1.1"
  }
}
