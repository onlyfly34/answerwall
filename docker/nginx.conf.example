# nginx as the TLS-terminating reverse proxy in front of AnswerWall
# (docker/compose.proxy.yaml). Goes into the `http` block, for example as
# /etc/nginx/conf.d/answerwall.conf. docker/test/smoke.mjs runs this file,
# with the three marked lines replaced, in front of the image.

server {
  listen 443 ssl;
  listen [::]:443 ssl;
  server_name wall.example.com; # replace

  ssl_certificate /etc/ssl/wall.example.com/fullchain.pem; # replace
  ssl_certificate_key /etc/ssl/wall.example.com/privkey.pem; # replace

  # The server refuses request bodies above 1 MB itself.
  client_max_body_size 1m;

  location / {
    # The port published by compose.yaml on the Docker host's loopback.
    proxy_pass http://127.0.0.1:7717; # replace
    proxy_http_version 1.1;
    proxy_set_header Connection "";

    # AnswerWall checks Host against ANSWERWALL_PUBLIC_ORIGINS. With a port
    # other than 443 in the public address, send "$host:$server_port".
    proxy_set_header Host $host;
    # Believed only because this proxy is listed in ANSWERWALL_TRUSTED_PROXIES.
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;

    # Answers arrive as a server-sent event stream (GET /api/ask/<id>/stream):
    # pass every chunk on at once, never cache or compress it, and do not cut
    # a connection that is only slow. The server sends a comment line every
    # 15 seconds, so the read timeout is not reached while it is alive.
    proxy_buffering off;
    proxy_cache off;
    gzip off;
    proxy_read_timeout 1h;
    proxy_send_timeout 1h;
  }
}

# Plain HTTP only redirects.
server {
  listen 80;
  listen [::]:80;
  server_name wall.example.com; # replace
  return 301 https://$host$request_uri;
}
