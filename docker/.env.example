# Settings for docker/compose.yaml. Copy to .env (same directory) and edit.
# Every line is optional: with an empty .env the server listens with HTTPS
# (its own private CA) on https://localhost:7717 of the Docker host only.
# Explained in docs/deploy-docker.md.

# --- Image -----------------------------------------------------------------
# A released version is safer than "latest" for upgrades you want to control.
#ANSWERWALL_IMAGE=ghcr.io/onlyfly34/answerwall:latest

# --- Who can reach the port --------------------------------------------------
# The address of the Docker host the port is published on.
#   127.0.0.1   only the Docker host itself (default)
#   0.0.0.0     every interface: other machines can connect. Use it only with
#               TLS on (setups B and C below), never with setup A.
#PUBLISH_ADDRESS=127.0.0.1
#PUBLISH_PORT=7717

# --- Setup B (default): built-in TLS with a private CA -----------------------
# Nothing to set for https://localhost:7717. For other machines, publish on a
# reachable address and name the server:
#PUBLISH_ADDRESS=0.0.0.0
#ANSWERWALL_TLS_HOSTNAMES=wall.home.arpa,192.168.1.20
#ANSWERWALL_PUBLIC_ORIGINS=https://wall.home.arpa:7717,https://192.168.1.20:7717

# --- Setup A: behind a reverse proxy that terminates TLS ---------------------
#COMPOSE_FILE=compose.yaml:compose.proxy.yaml
#ANSWERWALL_PUBLIC_ORIGINS=https://wall.example.com
# The subnet of the compose network and the proxy address the server trusts.
# The default trusts the network's gateway, which is how a proxy on the
# Docker host appears to the container.
#PROXY_SUBNET=172.30.77.0/24
#ANSWERWALL_TRUSTED_PROXIES=172.30.77.1

# --- Setup C: your own certificate files -------------------------------------
#COMPOSE_FILE=compose.yaml:compose.cert.yaml
#TLS_CERT_DIR=/srv/answerwall/certs
#TLS_CERT_FILE=fullchain.pem
#TLS_KEY_FILE=privkey.pem
#ANSWERWALL_PUBLIC_ORIGINS=https://wall.example.com:7717

# --- Optional ----------------------------------------------------------------
# A static bearer token for scripts, 16 to 512 characters. Anyone who has it
# is signed in; leave it unset unless you need it.
#ANSWERWALL_TOKEN=
#ANSWERWALL_LOG_LEVEL=info
#ANSWERWALL_LOG_FORMAT=text

# --- Where the state lives ---------------------------------------------------
# By default two named Docker volumes. To keep the state in directories of the
# Docker host instead, give two absolute paths and the user and group id that
# own them (create the directories first; `id -u` and `id -g` print yours).
#DATA_VOLUME=/srv/answerwall/data
#CLI_HOME_VOLUME=/srv/answerwall/home
#CONTAINER_USER=1000:1000
