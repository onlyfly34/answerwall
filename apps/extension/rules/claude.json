{
  "site": "claude",
  "host": "claude.ai",
  "start": "/new",
  "verified": false,
  "verifiedOn": null,
  "notes": "Written from the publicly visible structure of the page without signing in; never run against the real site. Check it by hand with docs/verify-web-cells.md before relying on it.",
  "signedOut": {
    "paths": ["/login", "/logout"],
    "selectors": []
  },
  "input": {
    "selectors": [
      "div.ProseMirror[contenteditable='true']",
      "[data-testid='chat-input'] [contenteditable='true']",
      "div[contenteditable='true'][role='textbox']",
      "fieldset div[contenteditable='true']"
    ]
  },
  "submit": {
    "selectors": [
      "button[aria-label='Send message']",
      "button[aria-label='Send Message']",
      "fieldset button[type='submit']"
    ],
    "enterKey": true
  },
  "answer": {
    "selectors": ["[data-is-streaming]", ".font-claude-response", ".font-claude-message"],
    "content": [".font-claude-response", ".font-claude-message"],
    "strip": ["button", "svg", "[aria-hidden='true']", "[role='toolbar']", "style", "script"]
  },
  "finished": {
    "busy": [
      "[data-is-streaming='true']",
      "button[aria-label='Stop response']",
      "button[aria-label='Stop Response']"
    ],
    "done": [],
    "failed": [],
    "quietMs": 1500
  }
}
