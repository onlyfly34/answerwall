{
  "site": "grok",
  "host": "grok.com",
  "start": "/",
  "verified": false,
  "verifiedOn": null,
  "notes": "Written from the publicly visible structure of the page without signing in; never run against the real site. Check it by hand with docs/verify-web-cells.md before relying on it.",
  "signedOut": {
    "paths": ["/sign-in", "/sign-up"],
    "selectors": []
  },
  "input": {
    "selectors": [
      "div.ProseMirror[contenteditable='true']",
      "textarea[aria-label='Ask Grok anything']",
      "form div[contenteditable='true']",
      "form textarea"
    ]
  },
  "submit": {
    "selectors": ["button[aria-label='Submit']", "form button[type='submit']"],
    "enterKey": true
  },
  "answer": {
    "selectors": [
      "[id^='response-'] .response-content-markdown",
      ".response-content-markdown",
      ".message-bubble .markdown"
    ],
    "content": [],
    "strip": ["button", "svg", "[aria-hidden='true']", "[role='toolbar']", "style", "script"]
  },
  "finished": {
    "busy": ["button[aria-label='Stop model response']", "button[aria-label='Stop']"],
    "done": [],
    "failed": [],
    "quietMs": 2000
  }
}
