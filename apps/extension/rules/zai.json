{
  "site": "zai",
  "host": "chat.z.ai",
  "start": "/",
  "verified": false,
  "verifiedOn": null,
  "notes": "Written from the publicly visible structure of the page without signing in; never run against the real site. Check it by hand with docs/verify-web-cells.md before relying on it.",
  "signedOut": {
    "paths": ["/auth"],
    "selectors": []
  },
  "input": {
    "selectors": [
      "#chat-input",
      "textarea#chat-input",
      "div#chat-input[contenteditable='true']",
      "form textarea"
    ]
  },
  "submit": {
    "selectors": ["#send-message-button", "button[type='submit']"],
    "enterKey": true
  },
  "answer": {
    "selectors": [".chat-assistant", "[id^='message-'] .markdown-prose", ".markdown-prose"],
    "content": ["#response-content-container", ".markdown-prose"],
    "strip": ["button", "svg", "[aria-hidden='true']", "[role='toolbar']", "style", "script"]
  },
  "finished": {
    "busy": ["button[aria-label='Stop']", "button.stop-response", "#stop-response-button"],
    "done": [],
    "failed": [],
    "quietMs": 2000
  }
}
