{
  "site": "chatgpt",
  "host": "chatgpt.com",
  "start": "/",
  "verified": false,
  "verifiedOn": null,
  "notes": "Written from the publicly visible structure of the page without signing in; never run against the real site. Check it by hand with docs/verify-web-cells.md before relying on it.",
  "signedOut": {
    "paths": ["/auth/"],
    "selectors": []
  },
  "input": {
    "selectors": [
      "#prompt-textarea",
      "div.ProseMirror[contenteditable='true']",
      "textarea[data-testid='prompt-textarea']",
      "form textarea"
    ]
  },
  "submit": {
    "selectors": [
      "button[data-testid='send-button']",
      "#composer-submit-button",
      "button[aria-label='Send prompt']",
      "button[aria-label='Send message']"
    ],
    "enterKey": true
  },
  "answer": {
    "selectors": [
      "[data-message-author-role='assistant']",
      "article[data-testid^='conversation-turn'] .agent-turn"
    ],
    "content": [".markdown"],
    "strip": ["button", "svg", "[aria-hidden='true']", "[role='toolbar']", "style", "script"]
  },
  "finished": {
    "busy": [
      "button[data-testid='stop-button']",
      "button[aria-label='Stop streaming']",
      ".result-streaming"
    ],
    "done": [],
    "failed": [],
    "quietMs": 1500
  }
}
